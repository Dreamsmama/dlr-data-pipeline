NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
API_HOST=0.0.0.0
# Leave empty to use the Web server's same-origin /api proxy.
NEXT_PUBLIC_API_BASE_URL=
# Server-side proxy target; the code defaults to http://127.0.0.1:3001.
INTERNAL_API_BASE_URL=http://127.0.0.1:3001
ALLOWED_WEB_ORIGINS=http://localhost:3000

# 可选：飞书任务本地持久化目录；默认 collectors/internal/run-data/feishu。
FEISHU_DATA_DIR=
# CLI 附件按消息后台下载；默认单次 30 分钟、失败最多尝试 3 次。
FEISHU_CLI_ATTACHMENT_TIMEOUT_MS=1800000
FEISHU_CLI_ATTACHMENT_MAX_ATTEMPTS=3
# local：仅本地 JSON；postgres-oss：PostgreSQL 元数据 + 私有 OSS 附件。
FEISHU_PERSISTENCE_MODE=local

# PostgreSQL: collectors must access it through packages/database.
POSTGRES_PORT=5432
POSTGRES_USER=dlr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dlr_data
DATABASE_URL=postgresql://dlr:change-me@127.0.0.1:5432/dlr_data

# Local development uses the public endpoint; same-region ECS may use -internal.
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=commerce-agent-raw
