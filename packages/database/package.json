{
  "name": "@dlr/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare:deps": "pnpm --filter @dlr/schemas build",
    "prebuild": "pnpm run prepare:deps",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm run prepare:deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "pnpm build && node dist/migrate.js",
    "check": "pnpm build && node dist/check.js"
  },
  "dependencies": {
    "@dlr/schemas": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
