NODE_ENV=production

# The admin UI has no authentication. Keep it on loopback until an authenticated
# reverse proxy or VPN is configured. Set 0.0.0.0 only after accepting that risk.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=3002
WEB_ORIGIN=FILL_WEB_ORIGIN
ALLOW_UNAUTHENTICATED_PUBLIC_ACCESS=false

# Internal Feishu data is production data and must use PostgreSQL + private OSS.
FEISHU_PERSISTENCE_MODE=postgres-oss
FEISHU_DATA_DIR=/data/feishu
LARK_CLI_HOME=/data/feishu/runtime/lark-cli-home

DATABASE_URL=FILL_POSTGRESQL_URL

ALIYUN_OSS_REGION=FILL_OSS_REGION
ALIYUN_OSS_ENDPOINT=FILL_OSS_ENDPOINT
ALIYUN_OSS_ACCESS_KEY_ID=FILL_ACCESS_KEY_ID
ALIYUN_OSS_ACCESS_KEY_SECRET=FILL_ACCESS_KEY_SECRET
ALIYUN_OSS_BUCKET_NAME=FILL_BUCKET_NAME

# Deployment safeguards and retention.
POSTGRES_TOOLS_IMAGE=postgres:17-alpine
MIN_FREE_DISK_MB=8192
MIN_AVAILABLE_MEMORY_MB=1024
DATABASE_BACKUP_RETENTION_COUNT=7
RELEASE_RETENTION_COUNT=5
DEEP_VERIFY_ON_DEPLOY=true
ALLOW_DESTRUCTIVE_MIGRATIONS=false

# Runtime isolation; these limits protect other projects on the same server.
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=768m
WEB_CPU_LIMIT=0.75
WEB_MEMORY_LIMIT=512m
MIGRATE_CPU_LIMIT=1.0
MIGRATE_MEMORY_LIMIT=1g
BACKUP_CPU_LIMIT=0.75
BACKUP_MEMORY_LIMIT=512m
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
