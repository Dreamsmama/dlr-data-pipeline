# Non-secret expectations for the current production server.
TARGET_OS_ID=ubuntu
TARGET_OS_MIN_VERSION=22.04
TARGET_ARCH=x86_64
TARGET_MIN_CPU_CORES=2
TARGET_MIN_TOTAL_MEMORY_MB=3000
TARGET_MIN_AVAILABLE_MEMORY_MB=1024
TARGET_MIN_FREE_DISK_MB=8192
TARGET_DOCKER_MIN_VERSION=24.0.0
TARGET_COMPOSE_MIN_VERSION=2.20.0
TARGET_PUBLIC_PORT=3002
TARGET_COMPOSE_PROJECT=dlr-data-pipeline
TARGET_INSTALL_ROOT=/opt/dlr-data-pipeline
