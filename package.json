{
  "name": "dlr-data-pipeline",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @dlr/web --filter @dlr/api dev",
    "dev:web": "pnpm --filter @dlr/web dev",
    "dev:api": "pnpm --filter @dlr/api dev",
    "dev:internal": "pnpm --filter @dlr/internal-collector dev",
    "dev:ecommerce": "pnpm --filter @dlr/ecommerce-collector dev",
    "collect:ecommerce:python": "pnpm --filter @dlr/ecommerce-collector collect:python",
    "extension:ecommerce:start": "pnpm --filter @dlr/ecommerce-collector extension:start",
    "extension:ecommerce:run": "pnpm --filter @dlr/ecommerce-collector extension:run",
    "collect:ecommerce:one-click": "node scripts/one-click-ecommerce.mjs",
    "import:ecommerce": "pnpm --filter @dlr/ecommerce-collector import:data",
    "test:ecommerce-collectors": "pnpm --filter @dlr/ecommerce-collector test:collectors",
    "migrate": "node scripts/migrate.mjs",
    "deploy:wuyang": "node scripts/deploy-to-wuyang.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2"
  }
}
